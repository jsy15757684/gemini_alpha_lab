# 빗썸 원화 자동매매 콘솔 — 환경변수
#
# cp .env.example .env  후 값을 채우세요. .env 는 gitignore 대상입니다.
# run.sh 가 실행 시 .env 를 자동으로 읽습니다.
# 값을 바꾼 뒤에는 반드시 서버를 재시작해야 반영됩니다.
#
# 주의: '=' 뒤에 공백을 두지 마세요. 실제 키를 이 파일에 적지 마세요(저장소에 올라갑니다).

# ── 필수 ────────────────────────────────────────────────
# 콘솔 접속 비밀번호. 없으면 모든 데이터 API 가 503 으로 잠깁니다(의도된 동작).
# 20자 이상 권장. 영문/숫자/-/_ 만 쓰면 붙여넣기·자판 문제가 없습니다.
APP_ACCESS_PASSWORD=

# ── 선택: 빗썸 실계좌 ──────────────────────────────────
# 환경변수로 넣으면 재배포·재시작에도 유지되고 디스크에 평문으로 남지 않습니다.
# 화면에서 등록해도 되지만 그건 서버 파일에 평문 저장되고 재시작 시 사라집니다.
# 빗썸 [API 관리] 에서 '자산 조회' + (실매매 시)'주문' 권한으로 발급하세요.
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=

# 빗썸은 API 키에 IP 등록을 요구합니다. 서버의 아웃바운드 IP 가 고정되지 않는
# 환경(PaaS 공용 대역 등)에서는 고정 IP 프록시를 경유하고 그 IP 하나만 등록하세요.
# 로컬 PC 에서 실행할 때는 비워두면 됩니다 (그 회선 IP 를 직접 등록).
#   예) http://아이디:비번@203.0.113.10:3128
BITHUMB_PROXY_URL=

# ── 선택: 운영 파라미터 ────────────────────────────────
# '=' 뒤에는 값만 씁니다. 인라인 주석(값 옆의 #)은 값의 일부로 읽힙니다.
# (비밀번호에 # 이 들어갈 수 있어 파서가 # 을 잘라내지 않습니다)

# 세션 유효시간(초). 기본 43200 = 12시간
APP_SESSION_TTL_SEC=

# 동시 가동 봇 상한. 기본 10
APP_MAX_ACTIVE_BOTS=

# 교차 출처 허용 목록. 비우면 동일 오리진만 (쿠키 인증이라 * 금지)
APP_ALLOWED_ORIGINS=

# 서버 포트. 기본 8888
PORT=
