# Gemini Alpha Lab 환경변수 예시
#
# 이 파일을 .env 로 복사해서 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 대상이라 저장소에 올라가지 않습니다.
# run.sh 가 실행 시 .env 를 자동으로 읽습니다.
#
# 실제 키를 이 파일(.env.example)에 적지 마세요. 여기는 저장소에 올라갑니다.

# ─────────────────────────────────────────────────────────────
# 필수
# ─────────────────────────────────────────────────────────────

# 콘솔 접속 비밀번호. 설정하지 않으면 모든 데이터 API 가 503 으로 잠깁니다(의도된 동작).
# 20자 이상 권장. 12자 미만이면 /api/auth/status 가 경고를 반환합니다.
APP_ACCESS_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 선택 — AI 분석
# ─────────────────────────────────────────────────────────────

# https://aistudio.google.com/apikey 에서 발급 (AIza... 로 시작)
# 없으면 감성·재무 코멘트가 생성되지 않고 화면에 "AI 미연결" 로 표시됩니다.
GEMINI_API_KEY=

# 비워두세요. 비어 있으면 사용 가능한 모델을 직접 조회해 고릅니다.
# 특정 모델을 강제할 때만 지정하고, 잘못된 이름은 /api/ai/status 가 잡아냅니다.
GEMINI_MODEL=

# ─────────────────────────────────────────────────────────────
# 선택 — 빗썸 실계좌 연동
# ─────────────────────────────────────────────────────────────

# 환경변수로 넣으면 재배포·재시작에도 살아남고 디스크에 평문으로 남지 않습니다.
# 화면에서 등록해도 되지만 그건 서버 파일에 평문 저장되고 재시작 시 사라집니다.
BITHUMB_API_KEY=
BITHUMB_SECRET_KEY=

# 빗썸은 API 키에 IP 등록을 요구합니다. PaaS 의 아웃바운드 IP 가 공용 대역이라
# 등록이 불가능할 때, 고정 IP 프록시를 경유하고 그 IP 하나만 빗썸에 등록합니다.
# 로컬(회사/집 PC)에서 실행할 때는 필요 없습니다 — 그 회선 IP 를 직접 등록하면 됩니다.
#   예) http://아이디:비번@203.0.113.10:3128
BITHUMB_PROXY_URL=

# ─────────────────────────────────────────────────────────────
# 선택 — 운영 파라미터 (기본값으로 두면 됩니다)
# ─────────────────────────────────────────────────────────────

# 세션 유효시간(초). 기본 43200 = 12시간
APP_SESSION_TTL_SEC=

# 동시 가동 봇 상한. 기본 20. 봇마다 스레드와 주기적 외부 호출이 붙습니다.
APP_MAX_ACTIVE_BOTS=

# 교차 출처 허용 목록(콤마 구분). 비워두면 동일 오리진만 허용합니다.
# 쿠키 인증을 쓰므로 * 는 사용하지 마세요.
APP_ALLOWED_ORIGINS=

# 서버 포트. 기본 8888 (Docker/Render 에서는 플랫폼이 주입합니다)
PORT=
